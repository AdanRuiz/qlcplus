<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.3.0</Version>
  <Author>Adan Ruiz</Author>
 </Creator>
 <Manufacturer>SteelPro</Manufacturer>
 <Model>Nova</Model>
 <Type>Moving Head</Type>
 <Channel Name="Pan" Default="127" Preset="PositionPan"/>
 <Channel Name="Tilt" Default="127" Preset="PositionTilt"/>
 <Channel Name="Head rotation">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="127" Preset="RotationIndexed">Position (0 - 360 degrees)</Capability>
  <Capability Min="128" Max="191" Preset="RotationClockwiseFastToSlow">Rotation fast to slow</Capability>
  <Capability Min="192" Max="255" Preset="RotationCounterClockwiseFastToSlow">Reverse rotation fast to slow</Capability>
 </Channel>
 <Channel Name="Pan/Tilt speed" Preset="SpeedPanTiltFastSlow"/>
 <Channel Name="Dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="0" Preset="ShutterOpen">Open</Capability>
  <Capability Min="1" Max="255" Preset="StrobeSlowToFast">Strobe slow to fast</Capability>
 </Channel>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="White" Preset="IntensityWhite"/>
 <Channel Name="Green laser">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Green laser 0 - 100%</Capability>
 </Channel>
 <Channel Name="Gold light">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Gold light 0 - 100%</Capability>
 </Channel>
 <Channel Name="Macro">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="50">DMX control</Capability>
  <Capability Min="51" Max="150">Auto program 1</Capability>
  <Capability Min="151" Max="255">Sound active 1</Capability>
 </Channel>
 <Channel Name="Reset">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="200">No function</Capability>
  <Capability Min="201" Max="255" Preset="ResetAll">Reset (after 3 seconds)</Capability>
 </Channel>
 <Mode Name="14 Channel">
  <Channel Number="0">Pan</Channel>
  <Channel Number="1">Tilt</Channel>
  <Channel Number="2">Head rotation</Channel>
  <Channel Number="3">Pan/Tilt speed</Channel>
  <Channel Number="4">Dimmer</Channel>
  <Channel Number="5">Strobe</Channel>
  <Channel Number="6">Red</Channel>
  <Channel Number="7">Green</Channel>
  <Channel Number="8">Blue</Channel>
  <Channel Number="9">White</Channel>
  <Channel Number="10">Green laser</Channel>
  <Channel Number="11">Gold light</Channel>
  <Channel Number="12">Macro</Channel>
  <Channel Number="13">Reset</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="5" Width="250" Height="350" Depth="200"/>
  <Lens Name="Other" DegreesMin="0" DegreesMax="0"/>
  <Focus Type="Head" PanMax="540" TiltMax="270"/>
  <Technical PowerConsumption="90" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
