<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>VertexAV Director</Name>
  <Version>0.1.1</Version>
  <Author>Adan Ruiz</Author>
 </Creator>
 <Manufacturer>Generic</Manufacturer>
 <Model>AH40-DH41 18x18W RGBW Par</Model>
 <Type>Color Changer</Type>
 <Channel Name="Master dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="White" Preset="IntensityWhite"/>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="0" Preset="ShutterOpen">No strobe</Capability>
  <Capability Min="1" Max="255" Preset="StrobeSlowToFast">Strobe slow to fast</Capability>
 </Channel>
 <Channel Name="Function">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="0">Dimming mode (colour channels)</Capability>
  <Capability Min="1" Max="62">Colour selection (chosen with the speed channel)</Capability>
  <Capability Min="63" Max="124">Colour jump</Capability>
  <Capability Min="125" Max="186">Colour gradient</Capability>
  <Capability Min="187" Max="249">Pulse change</Capability>
  <Capability Min="250" Max="255">Sound control (speed channel selects mode 1 or 2)</Capability>
 </Channel>
 <Channel Name="Function speed">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255" Preset="SlowToFast">Function speed slow to fast</Capability>
 </Channel>
 <Mode Name="8 Channel (A001)">
  <Channel Number="0">Master dimmer</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">White</Channel>
  <Channel Number="5">Strobe</Channel>
  <Channel Number="6">Function</Channel>
  <Channel Number="7">Function speed</Channel>
 </Mode>
 <Mode Name="8 Channel (D001)">
  <Channel Number="0">Master dimmer</Channel>
  <Channel Number="1">Strobe</Channel>
  <Channel Number="2">Function</Channel>
  <Channel Number="3">Function speed</Channel>
  <Channel Number="4">Red</Channel>
  <Channel Number="5">Green</Channel>
  <Channel Number="6">Blue</Channel>
  <Channel Number="7">White</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="2.5" Width="220" Height="220" Depth="120"/>
  <Lens Name="Other" DegreesMin="25" DegreesMax="25"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Layout Width="1" Height="1"/>
  <Technical PowerConsumption="324" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
